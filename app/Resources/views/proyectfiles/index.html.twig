<!DOCTYPE html>
<html lang="en">
<head>
    {% block head %}
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://code.jquery.com/jquery-4.0.0.min.js" integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao=" crossorigin="anonymous"></script>
    {% endblock %}
    
    <title>Inicio CRUD</title>
</head>
{% block body %}
<body> {#Este index tendrá cuatro opciones principalmente (respondiendo con la funcionalidad de un CRUD: Crear, leer, actualizar y borrar un usuario), que estarán bloqueadas a través de un inicio de sesión para cumplir con #}
    <header>
        <h1>Gestion de usuarios</h1>
        <h3>En esta página podrás Crear, Leer, Actualizar y Borrar un usuario (CRUD)<h3>
    </header>

    <main>
        <form id="Ini_sesion">
            <h4>Introduce tu email y tu contraseña<h4>
            <input type="text" placeholder="email" id="email" required>
            <input type="password" placeholder="contraseña" id="contraseña" required>
            <hr>
            <button type="submit">Iniciar Sesión</button>
        </form>
        <h3 style="color: red;" id="Res"></h3>
        <br>
        <div id="Registro">
            <h4>¿No tienes usuario creado o quieres crear otro usuario?</h4>
            <button type="submit" onclick="location.href='{{ path('Registro') }}'">Registrar Usuario</button>
        </div>
    </main>
    

    <script>
        $(document).ready(function(){
            $("#Res").hide();
            $("#Ini_sesion").on("submit", function(e){
                $("#Res").hide();
                e.preventDefault();

                var email=$("#email").val();
                var pswd=$("#contraseña").val();
                var datos={email: email, pswd: pswd};

                //Llamada a controlador pasandole la info. Este controlador decide que pagina cargar en funcion de si el usuario es admin (podra ver todos los clientes y eliminar o actualizar la informacion de cualquiera) o client (podra actualizar su informacion o eliminar su usuario)
                $.ajax({
                    url:" {{ path('Identificacion') }}",
                    type: 'POST',
                    data: datos,
                    success: function(res){
                        if(res.redirect){
                            window.location.href = res.redirect; // Redirigimos si todo es ok
                        } else {
                            $("#Res").html(res.error);
                            $("#Ini_sesion")[0].reset();
                            $("#Res").show();
                        }
                    },
                    error: function(xhr){
                        console.log(xhr.responseText);
                        alert("Error crítico en el servidor.");
                    }


                });
            });

        });
    </script>
</body>
{% endblock %}
</html>