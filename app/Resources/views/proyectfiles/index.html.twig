<!DOCTYPE html>
<html lang="es">
<head>
    {% block head %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="{{ asset('js/particles.min.js') }}"></script>
        <style>
            
            body { 

                background-image: url("{{ asset('img/coolbackground.png') }}");

                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                background-repeat: no-repeat;


                min-height: 100vh; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                background-color: #f0f2f5; 
            }
            .login-container { max-width: 500px; width: 100%; }

            .login-card {
                background-color: rgba(255, 255, 255, 0.9) !important;
                backdrop-filter: blur(5px); 
                border: none;
                box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            }

            
        </style>
    {% endblock %}
    <title>Inicio CRUD</title>
</head>

{% block body %}
<body class="p-3 bg-secondary-subtle">
<div id="particles-js" style="position: fixed; width: 100%; height: 100%; top: 0; left: 0; z-index: -1; background-color: #232741;"></div>
    <div class="login-container">
        
        <main class="card shadow border-0 overflow-hidden">
            
            <header class="card-header bg-primary bg-opacity-75 text-white text-center py-4 border-0">
                <h1 class="h3 fw-bold mb-1">Gestión de Usuarios</h1>
                <p class="small mb-0 opacity-75">Crea, Lee, Actualiza y Borra (CRUD)</p>
            </header>

            <div class="card-body p-4 text-center">
                <form id="Ini_sesion">
                    <h5 class="mb-3 text-secondary">Identificación</h5>
                    
                    <div class="mb-3">
                        <input type="email" class="form-control" placeholder="Email" id="email" required>
                    </div>
                    
                    <div class="mb-3">
                        <input type="password" class="form-control" placeholder="Contraseña" id="contraseña" required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Iniciar Sesión</button>
                </form>

                <div id="Res" class="alert alert-danger mt-3 py-2 small" style="display:none;"></div>

                <hr class="my-4">

                <div id="Registro">
                    <p class="small text-muted mb-2">¿No tienes usuario?</p>
                    <button type="button" class="btn btn-outline-success btn-sm px-4" onclick="location.href='{{ path('Registro') }}'">
                        Registrar Usuario
                    </button>
                </div>
            </div>
        </main>

        <footer class="text-center mt-3 text-muted small">
            &copy; 2026 Sistema CRUD
        </footer>
    </div>
    </div>

    <script>
        $(document).ready(function(){
            particlesJS.load('particles-js', '{{ asset('js/particlesjs-config.json') }}', function() {
                console.log('particles.js loaded - callback');
            });

            $("#Ini_sesion").on("submit", function(e){
                e.preventDefault();
                $("#Res").hide();

                $.ajax({
                    url:" {{ path('Identificacion') }}",
                    type: 'POST',
                    data: { email: $("#email").val(), pswd: $("#contraseña").val() },
                    success: function(res){
                        if(res.redirect) {
                            window.location.href = res.redirect;
                        } else {
                            $("#Res").html(res.error).fadeIn();
                            $("#Ini_sesion")[0].reset();
                        }
                    },
                    error: function() { alert("Error en el servidor."); }
                });
            });
        });
    </script>
</body>
{% endblock %}
</html>