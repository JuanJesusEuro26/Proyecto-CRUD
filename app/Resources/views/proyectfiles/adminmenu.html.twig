{% extends 'proyectfiles/index.html.twig' %}

{% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { background-color: #f8f9fa; padding-bottom: 50px; }
        .admin-header { background-color: #ffffff; border-bottom: 1px solid #dee2e6; padding: 2rem 0; margin-bottom: 2rem; }
        .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); border-radius: 0.75rem; }
        .table-container { background: white; border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
        .filter-section { background: #e9ecef; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 2rem; }
        .form-label { font-weight: 600; font-size: 0.875rem; }
    </style>
    <title>Panel de Administración</title>
{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="container text-center">
        <h1 class="fw-bold text-primary">Panel de Administración</h1>
        <p class="text-muted">Gestión centralizada de usuarios, filtros y mantenimiento de datos.</p>
    </div>
</div>

<div class="container">
    <main>
        <section class="filter-section shadow-sm">
            <h5 class="mb-3 fw-bold">Filtros de Búsqueda</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Estado de Cuenta</label>
                    <select id="Usuarios_Actividad" class="form-select">
                        <option value="">Todos (Activos e Inactivos)</option>
                        <option value="1">Solo Activos</option>
                        <option value="0">Solo Inactivos</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Rol de Usuario</label>
                    <select id="Usuarios_Rol" class="form-select">
                        <option value="">Todos los Roles</option>
                        <option value="1">Administradores</option>
                        <option value="2">Clientes</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nacidos antes de</label>
                    <input type="date" id="Usuarios_Antiguos" class="form-select" max="2009-12-12">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mínimo de Operaciones</label>
                    <input type="number" id="Usuarios_Operaciones" class="form-control" placeholder="Ej. 10">
                </div>
            </div>
        </section>

        <div id="contenedor_tabla" style="display:none;" class="table-container mb-4">
            <div class="table-responsive">
                <table id="tabla_usuarios" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>F. Nacimiento</th>
                            <th>Operaciones</th>
                            <th>Rol</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-7 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-4">Actualizar Usuario</h5>
                        <form id="ActualizarUser">
                            <div class="mb-3">
                                <label class="form-label">Email de Referencia</label>
                                <input id="emailuser" type="email" class="form-control bg-light" placeholder="Email del usuario a modificar" required>
                            </div>
                            
                            <div id="actualizardiv" style="display:none;" class="border-top pt-3 mt-3">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nuevo Email</label>
                                        <input id="newemail" type="email" class="form-control" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Nuevo Nombre</label>
                                        <input id="newname" type="text" class="form-control" required>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label d-block text-muted small uppercase mb-2">Asignar Rol</label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="rol_choice" id="rol_admin" value="1">
                                        <label class="btn btn-outline-primary" for="rol_admin">Administrador</label>
                                        <input type="radio" class="btn-check" name="rol_choice" id="rol_client" value="2" checked>
                                        <label class="btn btn-outline-primary" for="rol_client">Cliente</label>
                                    </div>
                                </div>
                            </div>
                            <button id="Actualizar" type="button" class="btn btn-primary px-4 fw-bold">Actualizar Datos</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 mb-4">
                <div class="card border-danger h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-danger mb-4">Acciones de Baja</h5>
                        <div id="eliminar">
                            <div class="mb-3">
                                <label class="form-label">Email para Eliminar</label>
                                <input id="emailaeliminar" type="email" class="form-control" placeholder="usuario@ejemplo.com">
                            </div>
                            <p class="text-muted small">Nota: Esta acción realizará un borrado lógico del usuario en el sistema.</p>
                            <button id="Eliminar" class="btn btn-danger px-4 fw-bold">Confirmar Baja</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="res" class="alert alert-info mt-3 py-2 text-center small" style="display:none;"></div>

        <div class="text-center mt-4">
            <button class="btn btn-link text-decoration-none text-muted" onclick="location.href='{{ path('index') }}'">
                Volver al Menú Principal
            </button>
        </div>
    </main>
</div>

<script>
    $(document).ready(function(){
        $("#res").hide();
        cargarTabla();

        // Eventos de cambio en filtros
        $("#Usuarios_Actividad, #Usuarios_Rol, #Usuarios_Antiguos, #Usuarios_Operaciones").change(function(){
            cargarTabla();
        });

        // Toggle del formulario de actualización
        $("#Actualizar").click(function(e) {
            if ($("#actualizardiv").is(":hidden")) {
                $("#actualizardiv").fadeIn();
                $(this).attr("type", "submit").text("Confirmar Cambios");
            } 
        });

        $("#ActualizarUser").on("submit", function(e){
            e.preventDefault();
            var datos = {
                "nuevoEmail": $("#newemail").val(),
                "nuevoNombre": $("#newname").val(),
                "nuevoRol": $("input[name='rol_choice']:checked").val(),
                "emailActual": $("#emailuser").val() 
            };

            $.ajax({
                url: "{{ path('ActualizarAdmin') }}",
                method: "POST",
                data: { datos: datos },
                success: function(res){
                    if(res.logout){
                        alert(res.logout);
                        window.location.href = "{{ path('index') }}";
                        return;
                    }
                    if(res.exito){
                        $("#res").removeClass('alert-danger').addClass('alert-info').html(res.exito).show();    
                        $("#emailuser, #newemail, #newname").val("");
                        cargarTabla(); 
                        $("#actualizardiv").fadeOut();
                        $("#Actualizar").attr("type", "button").text("Actualizar Datos");
                    } else if(res.error){
                        $("#res").html(res.error).show();
                    }
                }
            });
        });

        $("#Eliminar").click(function(){
            var emailABorrar = $("#emailaeliminar").val();
            if (emailABorrar === "") {
                $("#res").html("<span class='text-warning'>Introduzca un email.</span>").show();
                return;
            }

            if (confirm("Confirmar eliminación para: " + emailABorrar)) {
                $.ajax({
                    url: "{{ path('EliminarAdmin') }}",
                    method: "GET",
                    data: { email: emailABorrar },
                    success: function(res) {
                        if (res.logout) {
                            alert(res.mensaje);
                            window.location.href = "{{ path('index') }}";
                        } else if (res.exito) {
                            $("#res").html("<span class='text-success'>" + res.exito + "</span>").show();
                            $("#emailaeliminar").val("");
                            cargarTabla(); 
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = (xhr.responseJSON) ? xhr.responseJSON.error : "Error en proceso.";
                        $("#res").html("<span class='text-danger'>" + errorMsg + "</span>").show();
                    }
                });
            }
        });

        function cargarTabla(){
            $.ajax({
                url: "{{ path('ConsultarAdmin') }}",
                method: "POST",
                data: { filtros: {
                    "activos": $("#Usuarios_Actividad").val() || "",
                    "rol": $("#Usuarios_Rol").val() || "",
                    "Fechanacim": $("#Usuarios_Antiguos").val() || "",
                    "Numops": $("#Usuarios_Operaciones").val() || ""
                }},
                success: function(res){
                    $("#tabla_usuarios tbody").empty();
                    if(res.datos && res.datos.length > 0){
                        $.each(res.datos, function(index, user){
                            var rolTexto = (user.rol_id == 1) ? "Admin" : "Cliente";
                            var estadoTexto = (user.is_active == 1) ? "Activo" : "Inactivo";
                            var filaClass = (user.is_active == 0) ? "table-danger text-decoration-line-through" : "";
                            
                            var fila = "<tr class='" + filaClass + "'>" +
                                "<td class='fw-bold'>" + user.id + "</td>" +
                                "<td>" + user.nombre + "</td>" +
                                "<td>" + user.email + "</td>" +
                                "<td>" + user.fecha_nacimiento + "</td>" +
                                "<td>" + user.num_operaciones + "</td>" +
                                "<td><span class='badge bg-light text-dark border'>" + rolTexto + "</span></td>" +
                                "<td><span class='badge " + (user.is_active == 1 ? "bg-success" : "bg-danger") + "'>" + estadoTexto + "</span></td>" +
                            "</tr>";
                            $("#tabla_usuarios tbody").append(fila);
                        });
                        $("#contenedor_tabla").fadeIn();
                    } else {
                        $("#contenedor_tabla").hide();
                        $("#res").html("Sin resultados encontrados.").show();
                    }
                }
            });
        }
    });
</script>
{% endblock %}