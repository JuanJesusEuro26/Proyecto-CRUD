{% extends 'proyectfiles/index.html.twig' %}

{% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body { 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            background-color: #f0f2f5; 
        }
        .register-container { max-width: 500px; width: 100%; }
        .form-label { font-weight: 600; font-size: 0.9rem; color: #4b4b4b; }
    </style>
    <title>Registrar Usuario</title>
{% endblock %}

{% block body %}
<body class="p-3 bg-secondary-subtle">
    <div class="register-container">
        
        <main class="card shadow border-0 overflow-hidden">
            
            <header class="card-header bg-success bg-opacity-75 text-white text-center py-4 border-0">
                <h1 class="h3 fw-bold mb-1">Registro de Usuarios</h1>
                <p class="small mb-0 opacity-75">Crea una cuenta nueva en el sistema</p>
            </header>

            <div class="card-body p-4">
                <form id="Registro">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="ejemplo@correo.com" id="email" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre Completo</label>
                        <input type="text" class="form-control" placeholder="Tu nombre" id="nombre" required>
                    </div>

                    <div class="mb-3">
                        <label for="fechanacim" class="form-label">Fecha de Nacimiento</label>
                        <input type="date" class="form-control" id="fechanacim" required>
                    </div>

                    <div class="mb-3">
                        <label for="contraseña" class="form-label">Contraseña</label>
                        <input type="password" class="form-control" placeholder="••••••••" id="contraseña" required>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="root">
                        <label class="form-check-label text-muted small" for="root">Solicitar privilegios de Administrador (Root)</label>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Registrar Usuario</button>
                </form>

                <div id="Res" class="alert alert-info mt-3 py-2 text-center small" style="display:none;"></div>

                <div class="text-center mt-4">
                    <button class="btn btn-link btn-sm text-decoration-none text-muted" onclick="location.href='{{ path('index') }}'">
                        &larr; Volver al inicio de sesión
                    </button>
                </div>
            </div>
        </main>
    </div>

    <script>
        $(document).ready(function(){
            $("#Res").hide();

            $("#Registro").on("submit", function(e){
                e.preventDefault();
                $("#Res").fadeOut(100);

                var datos = {
                    email:  $("#email").val(),
                    nombre: $("#nombre").val(),
                    date:   $("#fechanacim").val(),
                    passwd: $("#contraseña").val(),
                    rol:    $("#root").is(':checked') ? 'ROLE_ADMIN' : 'ROLE_CLIENT'
                };

                $.ajax({
                    url: "{{ path('registraruser') }}",
                    type: 'POST',
                    data: datos,
                    success: function(res){
                        if(res.status === 'Success'){
                            $("#Registro")[0].reset();
                            $("#Registro").fadeOut(200, function(){
                                $("#Res").removeClass('alert-danger').addClass('alert-success')
                                      .html("¡Éxito! Usuario registrado correctamente.")
                                      .fadeIn();
                            });
                        } else {
                            $("#Res").removeClass('alert-success').addClass('alert-danger')
                                  .html("<strong>Error:</strong> " + res.error)
                                  .fadeIn();
                        }
                    },
                    error: function(xhr){
                        alert("Error crítico en el servidor.");
                    }
                });
            });
        });
    </script>
</body>
{% endblock %}